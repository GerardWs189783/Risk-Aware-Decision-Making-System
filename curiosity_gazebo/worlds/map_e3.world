<sdf version="1.8">
  <world name="default">
  
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.9 0.753 0.66 1</background>
      <grid>false</grid>
    </scene>  

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin> 

    <plugin
      filename="gz-sim-particle-emitter-system"
      name="gz::sim::systems::ParticleEmitter">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

  <model name="mars_dust_storm">

      <pose>0.0 0.0 -10.0 0 -1.57 0</pose> 
      <static>true</static>
      <link name="dust_link">
        <particle_emitter name="storm_emitter" type="box">
          <emitting>true</emitting>

          <size>50 50 0</size>
          <particle_size>0.1 0.1 0.1</particle_size>
          <lifetime>10</lifetime>
          <min_velocity>0.2</min_velocity>
          <max_velocity>1.0</max_velocity>
          <scale_rate>0</scale_rate>

          <rate>500</rate> 
          <material>

            <diffuse>0.7 0.5 0.3 0.1</diffuse>
            <specular>0.1 0.1 0.1</specular>
          </material>
        </particle_emitter>
      </link>
    </model>


    <model name='falling_rock2_3'>
      <link name='base_link'>
        <inertial>
          <pose>-0.014732 -0.014451 0.0037100000000000002 0 0 0</pose>
          <mass>646.50800000000004</mass>
          <inertia>
            <ixx>49.619999999999997</ixx>
            <ixy>4.0800000000000001</ixy>
            <ixz>-0.32400000000000001</ixz>
            <iyy>46.472000000000001</iyy>
            <iyz>-3.9260000000000002</iyz>
            <izz>51.061999999999998</izz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 2/6/files/meshes/FallingRock02_Collider.dae</uri>
              <scale>2.0 2.0 2.0</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 2/6/files/meshes/FallingRock02.dae</uri>
              <scale>2.0 2.0 2.0</scale>
            </mesh>
          </geometry>
          <material>
            <diffuse>0.8 0.3 0.2 1</diffuse>
            <specular>1 1 1 1</specular>
            <pbr>
              <metal>
                <albedo_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 2/6/files/materials/textures/FallingRocks_Albedo.jpg</albedo_map>
                <normal_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 2/6/files/materials/textures/FallingRocks_Normal.jpg</normal_map>
                <roughness_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 2/6/files/materials/textures/FallingRocks_Roughness.jpg</roughness_map>
              </metal>
            </pbr>
            <script>
              <uri>file:///home/gerard/.gz/fuel/fuel.gazebosim.org/openrobotics/models/falling rock 2/6/materials/scripts</uri>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 2/6/files/materials/textures</uri>
              <name>FallingRocks/FallingRocks_Diffuse</name>
            </script>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <enable_wind>false</enable_wind>
      </link>
      <pose>18.0 -0.3 -7.57 -0.15631130030212284 0.5110379544411211 0.68566906653785886</pose>
      <static>false</static>
      <self_collide>false</self_collide>
    </model>

    <!-- Martian Gravity-->
    <gravity>0 0 -3.711</gravity>


    <!-- Martian Map-->
    <!--<include>
      <uri>model://curiosity_path</uri>
      <name>curiosity_path</name>
      <pose>0 0 0 0 0 0</pose>
    </include> -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/jasmeetsingh/models/Mars Gale Crater Patch 2</uri>
      <name>mars_gale_crater</name>
      <pose>0 -0.7 -8.8 0 0 0</pose>
    </include>

    <physics name="fast_physics" type="ignored">
    <max_step_size>0.002</max_step_size>
    <real_time_factor>1.0</real_time_factor>
    <real_time_update_rate>500</real_time_update_rate>
  </physics>

  </world>
</sdf>
