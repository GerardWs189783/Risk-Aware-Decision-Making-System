 <root BTCPP_format="4">
     <BehaviorTree ID="MainTree">
        <KeepRunningUntilFailure>
            <ForceSuccess>

                <ReactiveSequence name="mission_loop">
                    
                    <CheckMissionObjective name="is_mission_still_valid" goal_output="{target_waypoint}"/>
                    
                    <Sequence name="mission_steps">
                        <ExecuteTask name="execute_mission_task"/>

                        <ReactiveSequence name="drive_to_goal">
                        
                            <Fallback name="obstacle_handler">
                                <CheckObstacle name="check_obstacle" target_tilt="{shared_tilt}" target_yaw="{shared_yaw}" target_distance="{shared_dist}"/>
                                <ReactToObstacle name="react_to_obstacle" target_tilt="{shared_tilt}" target_yaw="{shared_yaw}" target_distance="{shared_dist}"/>
                            </Fallback>

                            <FollowTrajectory name="follow_trajectory" goal_input="{target_waypoint}"/>

                            </ReactiveSequence>

                        <WaitForNextTask name="wait_for_next_task"/>
                    </Sequence>

                </ReactiveSequence>
            </ForceSuccess>
        </KeepRunningUntilFailure>
     </BehaviorTree>
 </root>